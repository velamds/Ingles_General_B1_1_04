pe": "text"}], "selected": 0, "correct": true}, {"text": "", "id": 4, "_data": [{"content": "We need to be very specific in our sales pitch. <br/>", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 5, "_data": [{"content": "<span class=\"strong\">Janet</span>:", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 6, "_data": [{"content": "We need to make sure they know what they are buying. <Br/>", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 7, "_data": [{"content": "<span class=\"strong\">Miranda</span>:", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 8, "_data": [{"content": "Personally, I think we should start by showing self-assurance and building good rapport with our client. <Br/>", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 9, "_data": [{"content": "<span class=\"strong\">Janet</span>:", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 10, "_data": [{"content": " I think that's a fantastic idea. ", "type": "text"}], "selected": 0, "correct": true}, {"text": "", "id": 11, "_data": [{"content": "I'm sure you'd agree that ", "type": "text"}], "selected": 0, "correct": true}, {"text": "", "id": 12, "_data": [{"content": "creating a Business Link page would work.<Br/> <span class=\"strong\">Miranda</span>:", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 13, "_data": [{"content": "Absolutely.", "type": "text"}], "selected": 0, "correct": true}, {"text": "", "id": 14, "_data": [{"content": " If you ask me, I think that this is going to help attract more followers and we should post company updates to promote engagement. <Br/>", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 15, "_data": [{"content": "<span class=\"strong\">Janet</span>:", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 16, "_data": [{"content": "Definitely.", "type": "text"}], "selected": 0, "correct": true}, {"text": "", "id": 17, "_data": [{"content": "What's your position on creating ads? <Br/>", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 18, "_data": [{"content": "<span class=\"strong\">Miranda</span>:", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 19, "_data": [{"content": " The way I see it, these ads could be targeted to specific audiences, industries, and regions.<br/>", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 20, "_data": [{"content": "<span class=\"strong\">Janet</span>:", "type": "text"}], "selected": 0, "correct": 0}, {"text": "", "id": 21, "_data": [{"content": "I like that idea.", "type": "text"}], "selected": 0, "correct": true}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "id": 0}], "type": "SLS", "id": 11, "stimuli_ids": []}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "_data": [{"type": "metadata", "contents": [{"content": "Peter's New Job", "type": "lesson_name"}, {"content": "The Sales Pitch", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 4, "type": "lesson"}, {"content": "B1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Describe routines and regular activities in a wider range of social and work contexts.", "type": "primary"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_1"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_2"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_3"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_4"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_5"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_6"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_7"}, {"content": " Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations.", "type": "secondary_8"}]}, {"content": "engenn6le04ob09re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Taking Part in a Meeting", "type": "heading"}, {"content": " When you are taking part in a meeting, it is important to respond to the ideas that are being discussed. Sometimes you will agree and sometimes you will not. Here are some ways you can agree politely in English:", "type": "describer"}, {"content": "{\"rows\":2,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"bold\\\"> Agreeing</span> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><ul><li>I agree.</li> <li>Right! </li> <li>Absolutely.</li> <li>I'm sure you'd agree that ...</li> <li>Definitely.</li> <li>I think that's a fantastic idea.</li></ul></span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "You can also agree with someone but not entirely, especially when there is a doubt or you are not sure of agreeing with something completely. <br/>", "type": "text"}, {"content": "{\"rows\":2,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Partial agreement\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><ul><li>I agree up to a point. However, ...</li><li>That's true, but ...</li><li>I agree with you in part, but ...</li><li>I agree with you in part, but ... </li><li>This is only partly true. </il></ul></span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": " Asking for and Giving Opinions", "type": "heading"}, {"content": "When you are taking part in a meeting, it is important to ask for others' opinions on a subject as well as giving your own. Here are some ways you can ask for and give opinions. ", "type": "describer"}, {"content": "{\"rows\":2,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Asking for Opinions \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Giving Opinions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"underline\\\">Always ask questions that encourage a response</span>:  <ul><li>What do you think about/of ... ?</li> <li>What's your position on ... ?</li> <li>How do you feel (about ... )? </li></ul>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"underline\\\">When you give opinions, make your opinions less forceful by using neutral statements</span>: <ul><li>The way I see it ... </li> <li>Personally, I think ...  </li> <li>If you ask me, ... </li> <li>I'd say ... </li></ul>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "<span class=\"strong\">What do you think about</span> our sales pitch?", "type": "example"}, {"content": "<span class=\"strong\">What's your position on</span> creating a website?", "type": "example"}, {"content": "<span class=\"strong\">The way I see it</span>, the sales pitch really needs to impress them. ", "type": "example"}, {"content": "<span class=\"strong\">Personally, I think</span> the best sales pitch is don't try to sell.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "sales pitch", "type": "name"}, {"content": "a presentation you make to persuade people to buy something", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We need to be very specific in our sales pitch.", "type": "example"}, {"content": "engenn6le04ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when discussing a sales pitch.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "self-assurance", "type": "name"}, {"content": "calmness; confidence", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  I think we should start by showing self-assurance.", "type": "example"}, {"content": "engenn6le04ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "rapport", "type": "name"}, {"content": "friendly understanding between people", "type": "definition"}, {"content": " (noun)", "type": "part_speech"}, {"content": "Example: We need to build good rapport with our client.", "type": "example"}, {"content": "engenn6le04ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "follower ", "type": "name"}, {"content": " someone tracking a particular person, group or organization on social media", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  This is going to help the company attract more followers online.", "type": "example"}, {"content": "engenn6le04ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "engagement", "type": "name"}, {"content": "when you become involved with someone or something in order to understand them", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: It's important to post company updates to promote engagement with the public.", "type": "example"}, {"content": "engenn6le04ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "selling point ", "type": "name"}, {"content": "a particular quality that something has which will make people want to buy it", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example:  We need to focus on our selling point and what makes us unique.", "type": "example"}, {"content": "engenn6le04ob09aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to liaise", "type": "name"}, {"content": "to exchange information in order to be more effective", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: We will be liaising with social media in order to create publicity for the company.", "type": "example"}, {"content": "engenn6le04ob09aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Read the situation. ", "type": "text"}, {"content": "Choose the role you want.", "type": "text"}, {"content": "Practice talking about the situation</br>in the role play. Continue speaking for </br>as long as you can.", "type": "text"}, {"content": "Then, switch roles with your partner.", "type": "text"}, {"content": "{\"rows\":4,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"underline\\\">Situation:</span><br/> <span class=\\\"strong\\\">Role 1:</span>: You are in a meeting at work. You are asked to share your opinion about a new software. Give your opinion.<br/> <span class=\\\"strong\\\"> Role 2:</span>: You are managing a meeting at work. You ask for an employee's opinion about a new software. Listen to their opinion. Agree with the their. Then, give your opinion. <br/>  Change  roles.\\\"}\"],\"styles\":\" intro_table_border\"}", "type": "table"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I ask for an opinion in a meeting.", "type": "text"}, {"content": "I give my opinion in a meeting.", "type": "text"}, {"content": "I agree politely in a meeting.", "type": "text"}]}]}