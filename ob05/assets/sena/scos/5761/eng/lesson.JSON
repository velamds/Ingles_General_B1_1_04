pe": "text"}], "correct": 1}], "id": 9}, {"_data": [{"type": "question", "contents": [{"content": "Would you mind telling me more about that?", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "engenn6le04ob05re3aud06", "type": "text"}], "correct": 1}], "id": 10}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_1", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 11}, {"_data": [{"type": "question", "contents": [{"content": "Thank you for your time, Mr. Farmani. Bye for now.", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "engenn6le04ob05re3aud07", "type": "text"}], "correct": 1}], "id": 12}, {"_data": [{"type": "question", "contents": [{"content": "", "type": "rec"}]}, {"content": "secondary_1", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 13}], "_data": [{"type": "instructions", "contents": [{"content": " \nLet's make a phone call. \n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 1", "type": "group_name"}]}, {"content": {"correct_feedback": "You are done!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Speaking", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: <span class=\"bullet\">\nListen to the audio. </span> <span class=\"bullet\">\nRecord yourself saying the sentences aloud.</span>\n <span class=\"bullet\">\nCompare yourself to the audio.</span>", "type": "text"}]}], "type": "SR1", "template_override": 1}, {"id": 4, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_2", "type": "objective"}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "<span class=\"strong\">Farmani</span>: ", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "Good afternoon, Ms. Morehouse. ", "type": "text"}], "correct": false}, {"text": "", "id": 2, "selected": 0, "_data": [{"content": "This is Giorgio Farmani \u2013 CEO of Holly's.<br/>", "type": "text"}], "correct": false}, {"text": "", "id": 3, "selected": 0, "_data": [{"content": "<span class=\"strong\">MIranda</span>:", "type": "text"}], "correct": 0}, {"text": "", "id": 4, "selected": 0, "_data": [{"content": "Oh, hello Mr. Farmani.", "type": "text"}], "correct": 0}, {"text": "", "id": 5, "selected": 0, "_data": [{"content": "Glad to finally have a chance to speak with you.", "type": "text"}], "correct": false}, {"text": "", "id": 6, "selected": 0, "_data": [{"content": "I've heard so much about you.<br/>", "type": "text"}], "correct": true}, {"text": "", "id": 7, "selected": 0, "_data": [{"content": "<span class=\"strong\">Farmani</span>: ", "type": "text"}], "correct": 0}, {"text": "", "id": 8, "selected": 0, "_data": [{"content": "All good things I hope. ", "type": "text"}], "correct": 0}, {"text": "", "id": 9, "selected": 0, "_data": [{"content": "So, Ms. Morehouse, what is this about?<br/>", "type": "text"}], "correct": true}, {"text": "", "id": 10, "selected": 0, "_data": [{"co