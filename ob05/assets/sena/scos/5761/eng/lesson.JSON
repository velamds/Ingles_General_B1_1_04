"stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn6le04ob05re2img05.jpg"}, {"text": "<span class=\"strong\">Miranda</span>: Miranda Morehouse speaking.<br/>\n<span class=\"strong\">Farmani</span>: Good afternoon, Ms. Morehouse. This is Farmani \u2013 CEO of Holly's. <br>\n<span class=\"strong\">Miranda</span>: Oh, hello Mr. Farmani. Glad to finally have a chance to speak with you. I've heard so much about you.", "id": 1, "time": "100", "image": "engenn6le04ob05re2img05.jpg"}, {"text": "<span class=\"strong\">Farmani</span>: All good things I hope. So, Ms. Morehouse, what is this about?<br/>\n<span class=\"strong\">Miranda</span>: Well, I heard through the grapevine that Holly's is looking to hire a PR agency. Would you mind telling me more about it?<br/>\n<span class=\"strong\">Farmani</span>: Not at all. Holly's is a mid-range chain of department stores with more than 300 stores across North America. Because we are growing fast, we are looking into hiring a PR agency to manage our image as well as creating publicity for our new clothing line.", "id": 2, "time": "13000", "image": "engenn6le04ob05re2img06.jpg"}, {"text": "<span class=\"strong\">Miranda</span>: Oh, that sounds great. Could you possibly tell me more about it?<br/>\n<span class=\"strong\">Farmani</span>: Sure. This PR agency will play a role in managing our company's communication with the media and helping us organize special events to promote our clothes.<br/>\n<span class=\"strong\">Miranda</span>: It sounds very exciting. I am sure Polygon and I, personally, are prepared for deadlines and the long hours expected to put in with a PR job.<br/>\n<span class=\"strong\">Farmani</span>: I'm glad to hear that. Do you mind sending me a proposal with your visions and ideas?<br/>\n<span class=\"strong\">Miranda</span>: Absolutely. We have experienced professionals that can definitely help you and your company. Thank you for your time, Mr. Farmani. Bye for now.", "id": 3, "time": "39000", "image": "engenn6le04ob05re2img07.jpg"}], "audiosrc": "engenn6le04ob05re2aud01", "coverimg": "engenn6le04ob05re2img05.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}