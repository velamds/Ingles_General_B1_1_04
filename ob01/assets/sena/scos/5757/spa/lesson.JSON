, "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"template_override": 1, "stimuli_ids": [], "questions": [{"responses": [{"correct": 1, "selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"contents": [{"type": "pdf", "content": "engenn6le04ob01re7pdf01.pdf"}], "type": "question"}]}], "type": "DWS", "id": 11, "_data": [{"contents": [{"type": "text", "content": " Let's make a decision!  Role-play a situation with your partner."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Take Away"}], "type": "group"}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}, {"type": "skill", "content": "Writing"}], "type": "learning_skills"}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le04ob01re2img05.jpg", "audiosrc": "engenn6le04ob01re2aud01", "images": [{"time": "0", "image": "engenn6le04ob01re2img05.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le04ob01re2img05.jpg", "id": 1, "text": "<span class=\"strong\">HR</span>: Hi, Janet. It's great to see you. <br />\n<span class=\"strong\">Janet</span>: Hiya, you too. It's been ages. You look well.<br />\n<span class=\"strong\">HR</span>: Thanks, you too. So, have you made up your mind about who's the best candidate?<br />\n<span class=\"strong\">Janet</span>: Well, I haven't decided yet. I'm considering my options."}, {"time": "18000", "image": "engenn6le04ob01re2img06.jpg", "id": 2, "text": "<span class=\"strong\">HR</span>: Right. You need to give it a lot of thought. But what do you like about them? What do they bring to the table? <br />\n<span class=\"strong\">Janet</span>: On the one hand, Eduardo is incredibly skilled and highly innovative. On the other hand, Peter is extremely perceptive and really communicative.  Peter has worked as an intern for a software company. He's done a lot of work online, especially with planning events."}, {"time": "40800", "image": "engenn6le04ob01re2img07.jpg", "id": 3, "text": "<span class=\"strong\">HR</span>: What about the other applicant?<br />\n<span class=\"strong\">Janet</span>: Eduardo? He did his internship with a finance company.<br />\n<span class=\"strong\">HR</span>: Sounds like you've got a tough decision to make. <br/><br/><span class=\"strong\">HR</span>:  Janet. It's me. I need to know if you've arrived at a decision.\n<br/><span class=\"strong\">Janet</span>: Yes! After giving it a lot of thought, I decided to go with Peter. <br/><span class=\"strong\">HR</span>: Great!"}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Peter's New Job"}, {"type": "unit_name", "content": "The Best Candidate"}, {"type": "position", "content": 1}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 4}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Describe routines and regular activities in a wider range of social and work contexts."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le04ob01re1img01.jpg"}, {"contents": [{"type": "name", "content": "to make up your mind"}, {"type": "definition", "content": "to \u200bdecide what to \u200bchoose"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Have you made up your mind about what to do?"}, {"type": "audio", "content": "engenn6le04ob01aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use when talking making a decision about a candidate."}], "type": "target_word_describer"}, {"contents": [{"type": "heading", "content": "Language for Making Decisions"}, {"type": "describer", "content": "Decision-making is an important skill, both in the workplace and in our everyday lives. Here's some language you can use to talk about decisions."}, {"type": "text", "content": "(verb) \tdecide (not) to: <span class =\"italic\">I have decided to leave the company. </span><br />(noun) decision: <span class =\"italic\">Leaving the company was a difficult decision.</span>"}, {"type": "text", "content": "You <span class =\"strong\">take, arrive at, come to</span> or <span class =\"strong\">make</span> a decision:"}, {"type": "text", "content": "<ul><li>As CEO of the company, she needs to <span class=\"strong\">make</span> tough decisions.</li><li>Have you <span class=\"strong\">arrived</span> at a decision?</li><li>Let me know when you have <span class=\"strong\">taken</span> your decision.</li><li> I will let you know once we <span class=\"strong\">come to</span> a decision.</li></ul>"}, {"type": "text", "content": "You can also use <span class=\"strong\">adjectives</span> to describe your decision.  "}, {"type": "table", "content": "{\"rows\":1,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"take <br />make <br />arrive at\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"a <span class=\\\"strong\\\">tough </span><br />a <span class=\\\"strong\\\">difficult</span> <br />an <span class=\\\"strong\\\">important</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<br />decision\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "text", "content": "<span class=\"italic\"><ul><li>It sounds like a difficult decision to make. She made the right decision.</li></ul>"}, {"type": "text", "content": "If you can't make a decision, you say you <span class=\"strong\">can't make up your mind</span>."}, {"type": "text", "content": "<span class=\"italic\"><ul><li>I can't make up my mind about who's the right person for this job</li></ul></span>"}, {"type": "text", "content": "If you are thinking about your choices, you say you are <span class=\"strong\">considering your options</span>."}, {"type": "text", "content": "<span class=\"italic\"><ul><li>I'm not sure, but I'm considering my options.</li></ul></span>"}, {"type": "text", "content": "If you need to think about making a decision, you <span class=\"strong\">give it a lot of thought</span>."}, {"type": "text", "content": "<span class=\"italic\"><ul><li>It's a difficult decision and I need to give it a lot of thought.</li></ul></span>"}, {"type": "text", "content": "When you are thinking about your decision and want to give two different opinions about someone or something, you use <span class=\"strong\">on the one hand ... on the other hands</span>."}, {"type": "text", "content": "<span class=\"italic\"><ul><li>On the one hand, he is really communicative. On the other hand, she is extremely perceptive. </li></ul></span>"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": " Starting a Conversation With Someone You Know"}, {"type": "describer", "content": " In English, there are certain expressions and words you use to greet and start a conversation with someone you know. Look at the charts below. "}, {"type": "table", "content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Saying \u2018Hello'\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Follow-up\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><ul><li>Hi!</li><li> Hello!</li><li> Hey!</li><li> Hiya!</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><ul><li>it's <span class=\\\"strong\\\">great/ nice/ good</span> to see you</li><li>It's been <span class=\\\"strong\\\">ages/a while</span></li><li>You look <span class=\\\"strong\\\">well!/ good!</span></li></ul></span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "table", "content": "{\"rows\":2,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Responses\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Questions\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Responses\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><ul><li>And you!</li> <li>You too!</li></ul>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> <ul><li>How are you doing?</li><li> How are things?</li></ul>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"><ul><li>Good, thanks.</li><li> Very well, thanks.</li><li> Not too bad, thanks.</li></ul>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "Hi, Sara. It's great to see you.  "}, {"type": "example", "content": "Hiya. You too. It's been ages."}, {"type": "example", "content": "How are things? Very well, thanks."}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "to give it thought "}, {"type": "definition", "content": "to carefully think about something; to consider"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I have given it a lot of thought."}, {"type": "audio", "content": "engenn6le04ob01aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "software "}, {"type": "definition", "content": "the sets of programs that tell a computer how to do a particular job"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I worked for a software company. "}, {"type": "audio", "content": "engenn6le04ob01aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "online"}, {"type": "definition", "content": " available through the Internet"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: He has done some work online as well."}, {"type": "audio", "content": "engenn6le04ob01aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "finance "}, {"type": "definition", "content": " the management of money by large organizations"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: He did his internship with a finance company. "}, {"type": "audio", "content": "engenn6le04ob01aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "bring to the table"}, {"type": "definition", "content": "providing something that will be a benefit "}, {"type": "part_speech", "content": " (expression)"}, {"type": "example", "content": "Example: What does each candidate bring to the table?"}, {"type": "audio", "content": "engenn6le04ob01aud09"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "skilled "}, {"type": "definition", "content": "someone who has the training and experience that is needed to do something well"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: He is incredibly skilled. "}, {"type": "audio", "content": "engenn6le04ob01aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "innovative   "}, {"type": "definition", "content": "using clever new ideas and methods"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: We were surprised by how innovative he was"}, {"type": "audio", "content": "engenn6le04ob01aud07"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "perceptive "}, {